# Базовый адрес бэкенда.
# Если бэкенд поднят в докере (через Caddy) — используется порт 80.
NEXT_PUBLIC_API_BASE_URL=http://localhost

# Если бэкенд поднят локально через `make run` (без докера/Caddy):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5050

# Публичный адрес самого фронтенда (для sitemap/robots/hreflang).
# В проде — реальный домен, например https://tiniq.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
